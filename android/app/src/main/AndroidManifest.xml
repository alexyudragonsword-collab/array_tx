<?xml version="1.0" encoding="utf-8"?>
<!--
  No permission element anywhere, on purpose.  The app computes locally: the
  WebView loads file:///android_asset, Python runs in-process, nothing is
  fetched and nothing is sent.  tests/test_android.py asserts the absence.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:label="array_tx"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="array_tx"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
